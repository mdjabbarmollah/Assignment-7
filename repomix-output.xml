<file path="src/app/page.tsx">
import Hero from '@/component/Hero';
import ProductCard from '@/component/ProductCard';
import { getProducts } from '@/lib/api';
import { toBengaliNumber, type Product } from '@/lib/utils';

type SectionProps = {
  id?: string;
  title: string;
  titleColor?: string;
  subtitle?: string;
  products: Product[];
};

const Section = ({
  id,
  title,
  titleColor,
  subtitle,
  products,
}: SectionProps) => (
  <section id={id} className="scroll-mt-4">
    <h2 className={`text-lg font-bold ${titleColor ?? 'text-[#1D271F]'}`}>
      {title}
    </h2>
    {subtitle && (
      <p className="mt-1 text-xs text-base-content/60">{subtitle}</p>
    )}
    <div className="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {products.map(p => (
        <ProductCard key={p.id} product={p} />
      ))}
    </div>
  </section>
);

const HomePage = async () => {
  const products = await getProducts();

  
  const risers = products
    .filter(p => p.change.pct > 0)
    .sort((a, b) => b.change.pct - a.change.pct)
    .slice(0, 6);

  
  const fallers = products
    .filter(p => p.change.pct < 0)
    .sort((a, b) => a.change.pct - b.change.pct)
    .slice(0, 6);

  return (
    <div className="space-y-10">
      <Hero />

      <Section
        title="▲ আজ দাম বেড়েছে"
        titleColor="text-red-600"
        products={risers}
      />

      <Section
        title="▼ আজ দাম কমেছে"
        titleColor="text-green-600"
        products={fallers}
      />

      <Section
        id="সব-পণ্য"
        title="সব পণ্য"
        subtitle={`মোট ${toBengaliNumber(products.length)}টি পণ্য দেখানো হচ্ছে`}
        products={products}
      />
    </div>
  );
};

export default HomePage;
</file>

<file path="README.md">
# 🛒 বাজার দর (BazarDor)

নিত্যপ্রয়োজনীয় পণ্যের দৈনিক বাজারদর এক নজরে দেখার একটি ওয়েব অ্যাপ। চাল, ডাল, তেল, সবজি, মাছ, মাংস, ডিম ও মসলার দাম, বাজারভিত্তিক তুলনা এবং দামের পরিবর্তন দেখা যায়।

🔗 **Live:** আপনার-লাইভ-লিংক
📦 **Repo:** আপনার-গিটহাব-লিংক

## ✨ মূল ফিচার

1. **লাইভ প্রাইস টিকার:** অনন্ত স্ক্রলিং স্ট্রিপে পণ্যের নাম, দাম ও ▲/▼ পরিবর্তন
2. **দাম বাড়া/কমার সেকশন:** আজ সবচেয়ে বেশি বাড়া ও কমা ৬টি করে পণ্য
3. **ক্যাটাগরি ও সর্টিং:** ক্যাটাগরি অনুযায়ী পণ্য এবং দাম অনুযায়ী সাজানো (বাংলা সংখ্যাসহ)
4. **বাজারভিত্তিক দাম:** প্রতিটি পণ্যের সর্বনিম্ন, সর্বোচ্চ ও গড় দাম, বাজারের তালিকাসহ
5. **ইউজার অথেনটিকেশন:** ইমেইল-পাসওয়ার্ড, Google ও GitHub লগইন, প্রোটেক্টেড রুট এবং প্রোফাইল আপডেট

## 🛠️ ব্যবহৃত প্রযুক্তি

- Next.js (App Router), TypeScript
- Tailwind CSS, DaisyUI
- Better Auth, MongoDB
- react-hot-toast

## 🚀 লোকালে চালানো

\`\`\`bash
git clone আপনার-রিপো-লিংক
cd আপনার-ফোল্ডার
npm install
npm run dev


`.env.local` এ দিন: `MONGODB_URI`, `BETTER_AUTH_SECRET`, `BETTER_AUTH_URL`, `NEXT_PUBLIC_APP_URL`, `GOOGLE_CLIENT_ID`, `GOOGLE_CLIENT_SECRET`, `GITHUB_CLIENT_ID`, `GITHUB_CLIENT_SECRET`
</file>

